
# Generate a random 32-byte local secret; do not reuse in production.
LOCAL_SESSION_SECRET=
# Set true only when the local workspace is served over HTTPS.
LOCAL_HTTPS=false

# Public app connection settings. Never put management/access/secret keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Configure locally, then enable after migrations/bootstrap pass.
SUPABASE_SERVER_SECRET_KEY=
MIS_BACKEND=local
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Explicit synthetic fixture access for a test environment only.
# Keep false for real school data. This also blocks synthetic identities with valid Auth sessions.
MIS_TEST_ACCOUNTS_ENABLED=false

# Railway: use MIS_BACKEND=supabase and set NEXT_PUBLIC_APP_URL to your HTTPS domain.
# Service configuration is in .railway/railway.ts (apply explicitly using Railway CLI).
# See docs/railway-deployment.md for the complete variable/service checklist.

# Optional first platform administrator bootstrap, used only by the explicit CLI.
# Use a new email and remove the password after bootstrap. Never expose these publicly.
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_NAME=
PLATFORM_BOOTSTRAP_PASSWORD=
