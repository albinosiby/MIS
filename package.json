{
  "name": "school-admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "audit:ui": "node scripts/audit-ui-bindings.ts",
    "fixture:ui": "node scripts/create-ui-audit-fixture.ts",
    "check:supabase": "node scripts/check-supabase.ts",
    "worker": "node scripts/run-school-worker.ts",
    "worker:once": "node scripts/run-school-worker.ts --once",
    "start:railway": "node scripts/check-deployment-env.ts web && next start --hostname 0.0.0.0",
    "worker:railway": "node scripts/check-deployment-env.ts worker && node scripts/run-school-worker.ts",
    "platform:bootstrap": "node scripts/bootstrap-platform-admin.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "regenerator-runtime": "0.14.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "railway": "3.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
